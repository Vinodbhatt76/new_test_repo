#!/bin/bash

BASE_DIR="/home"
NINJA_GROUP="ninjateam"

# Ensure ninja group exists
getent group $NINJA_GROUP > /dev/null || groupadd $NINJA_GROUP

add_team() {
    local team=$1
    getent group "$team" > /dev/null || groupadd "$team"
    echo "Team '$team' created."
}

add_user() {
    local username=$1
    local team=$2

    if ! getent group "$team" > /dev/null; then
        echo "Team '$team' does not exist. Create it first."
        exit 1
    fi

    useradd -m -g "$team" -G "$NINJA_GROUP" "$username"

    user_home="$BASE_DIR/$username"

    chmod 751 "$user_home"  # rwx--x--x

    mkdir -p "$user_home/team"
    mkdir -p "$user_home/ninja"

    chown "$username:$team" "$user_home/team"
    chown "$username:$NINJA_GROUP" "$user_home/ninja"

    chmod 770 "$user_home/team"
    chmod 770 "$user_home/ninja"

    echo "User '$username' added to team '$team'."
}

delete_user() {
    local username=$1
    userdel -r "$username"
    echo "User '$username' deleted."
}

delete_team() {
    local team=$1
    if getent group "$team" > /dev/null; then
        for user in $(getent passwd | grep "/home/" | cut -d: -f1); do
            if id -nG "$user" | grep -qw "$team"; then
                delete_user "$user"
            fi
        done
        groupdel "$team"
        echo "Team '$team' deleted."
    else
        echo "Team '$team' doesn't exist."
    fi
}

change_shell() {
    local username=$1
    local shell=$2
    chsh -s "$shell" "$username"
    echo "Shell for '$username' changed to '$shell'."
}

change_password() {
    local username=$1
    passwd "$username"
}

list_users() {
    echo "Users:"
    awk -F: -v home="$BASE_DIR" '$6 ~ home {print $1}' /etc/passwd
}

list_teams() {
    echo "Teams:"
    getent group | grep -v "$NINJA_GROUP" | awk -F: '$3 >= 1000 {print $1}'
}

case "$1" in
    addTeam)
        add_team "$2"
        ;;
    addUser)
        add_user "$2" "$3"
        ;;
    delUser)
        delete_user "$2"
        ;;
    delTeam)
        delete_team "$2"
        ;;
    changeShell)
        change_shell "$2" "$3"
        ;;
    changePasswd)
        change_password "$2"
        ;;
    ls)
        if [ "$2" == "User" ]; then
            list_users
        elif [ "$2" == "Team" ]; then
            list_teams
        else
            echo "Unknown list option. Use 'User' or 'Team'."
        fi
        ;;
    *)
        echo "Usage:"
        echo "./UserManager.sh addTeam <teamname>"
        echo "./UserManager.sh addUser <username> <teamname>"
        echo "./UserManager.sh delUser <username>"
        echo "./UserManager.sh delTeam <teamname>"
        echo "./UserManager.sh changeShell <username> <shell>"
        echo "./UserManager.sh changePasswd <username>"
        echo "./UserManager.sh ls User|Team"
        ;;
esac
